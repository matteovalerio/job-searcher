# Chiavi API opzionali: senza, le rispettive fonti vengono saltate.
# Adzuna (gratuita): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (gratuita, aggrega molti portali italiani): https://jooble.org/api/about
JOOBLE_API_KEY=
# Se Jooble restituisce sempre 0 risultati prova il dominio italiano:
# JOOBLE_HOST=it.jooble.org

# Indeed e InfoJobs (si usa un vero browser, vedi README)
# JOB_SEARCHER_HEADLESS=1
# JOB_SEARCHER_BROWSER=chrome
# JOB_SEARCHER_BROWSER_PATH=
# INDEED_HOST=it.indeed.com
# InfoJobs: indirizzo della ricerca con {keyword} e {place} (vedi README)
# INFOJOBS_SEARCH_URL=
# Cartella dei profili (default: profiles)
# JOB_SEARCHER_PROFILES=

# Notifiche delle offerte nuove (opzione --notify, vedi README)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_TO=
# EMAIL_FROM=
# inPA: indirizzo dell'interfaccia, se cambia (vedi README)
# INPA_API_URL=
