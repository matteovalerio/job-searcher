# Chiavi API opzionali: senza, le rispettive fonti vengono saltate.
# Adzuna (gratuita): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (gratuita, aggrega molti portali italiani): https://jooble.org/api/about
JOOBLE_API_KEY=
# Se Jooble restituisce sempre 0 risultati prova il dominio italiano:
# JOOBLE_HOST=it.jooble.org

# Indeed (si usa un vero browser, vedi README)
# INDEED_HEADLESS=1
# INDEED_BROWSER=chrome
# INDEED_BROWSER_PATH=
# INDEED_HOST=it.indeed.com
